---

<Layout 
  title="Beyond the Chapters — Featured Web Novels | Manga Anime Webtoon" 
  description="Web novel recommendations with summaries, genres and status notes across fantasy, mystery and progression fiction."
>
  <!-- Hero Section with Literary Editorial Tone -->
  <section class="relative w-full overflow-hidden bg-canvas pt-16 pb-12 md:pt-24 md:pb-16 px-lg border-b border-hairline">
    <!-- Subtle Ambient Glow -->
    <div class="absolute inset-0 z-0 opacity-30 pointer-events-none overflow-hidden flex justify-center">
      <div class="absolute -top-24 w-[720px] h-[360px] bg-gradient-to-r from-indigo-200 via-sky-200 to-amber-100 blur-[110px] rounded-full"></div>
    </div>

    <div class="relative z-10 max-w-[1280px] mx-auto flex flex-col gap-md">
      <!-- Section Tag / Eyebrow -->
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-hairline bg-canvas-soft text-caption font-mono uppercase tracking-widest text-ink">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-600"></span>
          Web Novels
        </span>
        <span class="text-caption font-mono text-mute tracking-wider hidden sm:inline">Literary Collection</span>
      </div>

      <!-- Main Headline -->
      <div class="flex flex-col gap-3">
        <h1 class="text-display-lg md:text-display-xl font-semibold tracking-[-1.5px] md:tracking-[-2px] text-ink max-w-[20ch]">
          Web novel recommendations
        </h1>
        <p class="text-display-sm font-normal text-body text-slate-600 tracking-tight max-w-[32ch]">
          Browse by genre and premise
        </p>
      </div>

      <!-- Editorial Intro Copy -->
      <div class="mt-2 max-w-[820px] flex flex-col gap-3 text-body-md md:text-body-lg text-body text-slate-700 leading-relaxed">
        <p>
          Browse web novels across fantasy, mystery and progression fiction. Each listing includes a premise, author, genre and status.
        </p>
        <p class="text-slate-600 text-body-md">
          Choose a title by genre, premise or current status.
        </p>
      </div>

      <!-- Editorial Motto Pill -->
      <div class="mt-4 pt-4 border-t border-hairline flex flex-wrap items-center gap-3">
        <span class="font-mono text-caption uppercase tracking-widest text-mute">Origins</span>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-canvas-soft border border-hairline text-body-sm font-medium text-ink">
          <span class="text-indigo-600">Chinese, Korean and Western serials</span>
          <span class="text-mute">·</span>
          <span>Read.</span>
          <span class="text-mute">·</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main 3-Column Cover-Art Grid -->
  <section class="w-full bg-canvas py-12 md:py-16 px-lg">
    <div class="max-w-[1280px] mx-auto flex flex-col gap-10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-hairline pb-4">
        <div>
          <h2 class="text-display-sm md:text-display-md font-semibold text-ink tracking-tight">
            Featured Web Novels
          </h2>
          <p class="text-body-sm text-mute mt-1">
            Chinese, Korean and Western serials, with a premise, author and genre for each title.
          </p>
        </div>
        <div class="text-caption font-mono text-mute">
          8 Masterpieces Selected
        </div>
      </div>

      <!-- 3-Column Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredNovels.map((novel, index) => (
          <article 
            class="group flex flex-col bg-white rounded-2xl border border-hairline hover:border-slate-300 transition-all duration-300 shadow-[0_4px_20px_-10px_rgba(0,0,0,0.05)] hover:shadow-[0_20px_40px_-15px_rgba(15,23,42,0.12)] overflow-hidden"
          >
            <!-- Book Cover Showcase -->
            <div class="relative w-full aspect-[2/3] bg-slate-100 overflow-hidden border-b border-hairline">
              <img 
                src={novel.coverImage} 
                alt={`${novel.title} book cover`}
                class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                loading={index < 3 ? 'eager' : 'lazy'}
              />
              
              <!-- Subtle vignette overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/10 opacity-60 group-hover:opacity-40 transition-opacity"></div>

              <!-- Top Badges -->
              <div class="absolute top-3 left-3 right-3 flex items-center justify-between gap-2 pointer-events-none">
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-mono font-medium tracking-wide uppercase bg-black/75 text-white backdrop-blur-md border border-white/20 shadow-sm">
                  {novel.origin}
                </span>

                {novel.featuredBadge && (
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold tracking-wide uppercase bg-amber-500 text-black shadow-md">
                    <span>★</span>
                    <span>{novel.featuredBadge}</span>
                  </span>
                )}
              </div>

              <!-- Bottom Cover Title Plaque (for fast visual identity) -->
              <div class="absolute bottom-3 left-3 right-3 pointer-events-none">
                <span class="text-[12px] font-mono text-white/90 drop-shadow-md">
                  #{String(index + 1).padStart(2, '0')} Selection
                </span>
              </div>
            </div>

            <!-- Novel Details & Editorial Synopsis -->
            <div class="p-6 flex flex-col flex-1 justify-between gap-4">
              <div class="flex flex-col gap-2.5">
                <!-- Genre List -->
                <div class="flex items-center flex-wrap gap-1.5 text-caption font-medium text-indigo-600">
                  {novel.genres.map((genre, gIdx) => (
                    <span class="inline-flex items-center">
                      <span>{genre}</span>
                      {gIdx < novel.genres.length - 1 && (
                        <span class="text-slate-300 mx-1.5 font-normal">·</span>
                      )}
                    </span>
                  ))}
                </div>

                <!-- Title & Author -->
                <div>
                  <h3 class="text-display-sm font-semibold text-ink group-hover:text-indigo-600 transition-colors leading-snug">
                    {novel.title}
                  </h3>
                  <p class="text-caption font-mono text-mute mt-0.5">
                    by {novel.author}
                  </p>
                </div>

                <!-- Literary Synopsis -->
                <p class="text-body-sm text-body text-slate-600 leading-relaxed mt-1">
                  {novel.description}
                </p>
              </div>

              <!-- Highlights / Why it's worth reading -->
              {novel.highlights && (
                <div class="pt-4 border-t border-hairline mt-auto">
                  <p class="text-[11px] font-mono uppercase tracking-wider text-mute mb-1.5">Hallmarks</p>
                  <div class="flex flex-wrap gap-1.5">
                    {novel.highlights.map((h) => (
                      <span class="text-[11px] px-2 py-0.5 rounded bg-slate-50 border border-slate-200/70 text-slate-600">
                        {h}
                      </span>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Upcoming Novels & On Our Radar Section -->
  <section class="w-full bg-canvas-soft py-16 px-lg border-t border-hairline">
    <div class="max-w-[1280px] mx-auto flex flex-col gap-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <span class="font-mono text-caption uppercase tracking-wider text-indigo-600 font-medium">On Our Radar</span>
          <h2 class="text-display-md font-semibold text-ink tracking-tight mt-1">
            Upcoming Web Novels & Reader Suggestions
          </h2>
          <p class="text-body-sm text-body text-mute max-w-[680px] mt-1">
            These titles are under review for future features and reading guides.
          </p>
        </div>
        <span class="text-caption font-mono text-mute hidden sm:inline">6 Works Queued</span>
      </div>

      <!-- Upcoming Novels 2x3 or 3x2 Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {upcomingNovels.map((item) => (
          <div class="bg-white p-5 rounded-xl border border-hairline hover:border-slate-300 transition-colors flex flex-col justify-between gap-3 shadow-xs">
            <div class="flex flex-col gap-2">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[11px] font-mono uppercase text-mute tracking-wider">{item.origin}</span>
                <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-100 font-medium">
                  {item.status}
                </span>
              </div>
              <h4 class="text-[17px] font-semibold text-ink leading-snug">
                {item.title}
              </h4>
              <p class="text-[12px] font-mono text-slate-500">
                by {item.author}
              </p>
              <div class="flex flex-wrap gap-1 text-[11px] text-indigo-600 font-medium">
                {item.genres.join(' · ')}
              </div>
              <p class="text-body-sm text-slate-600 leading-relaxed mt-1">
                {item.teaser}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- Suggest a Novel Callout Box -->
      <div class="mt-4 p-6 rounded-2xl border border-dashed border-slate-300 bg-white/70 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h4 class="text-body-md font-semibold text-ink">Have a web novel to recommend?</h4>
          <p class="text-body-sm text-mute mt-0.5">
            Send us the title and what you like about it.
          </p>
        </div>
        <a 
          href="https://mail.google.com/mail/?view=cm&fs=1&to=admin%40mangaanimewebtoon.com&su=Web%20Novel%20Recommendation"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 px-4 py-2 rounded-full bg-ink text-white hover:bg-slate-800 text-body-sm font-medium transition-colors"
        >
          Submit a Recommendation
        </a>
      </div>
    </div>
  </section>
</Layout>
