  {
    title: 'The Beginning After the End',
    author: 'TurtleMe',
    origin: 'Western Web Serial',
    genres: ['Progression Fantasy', 'Reincarnation'],
    teaser: 'A former monarch is reborn in a world of magic and monsters and tries to build a different life.',
    status: 'Editorial In Review',
  },
  {
    title: "A Regressor's Tale of Cultivation",
    author: 'Dorae',
    origin: 'Korean Web Novel',
    genres: ['Cultivation', 'Time Loop', 'Philosophy'],
