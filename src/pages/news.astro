---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/ui/Badge.astro';

interface ReleaseAnnouncement {
  id: string;
  title: string;
  timeline: string;
  type: string;
  studio: string;
  badge?: string;
  tags: string[];
  description: string;
  image: string;
  sourceLabel: string;
}

const releaseSchedule: ReleaseAnnouncement[] = [
  {
    id: 'ghost-in-the-shell',
    title: 'Ghost in the Shell: The New Era',
    timeline: 'July 7, 2026',
    type: 'TV Series Premiere',
    studio: 'Science SARU',
    badge: 'Confirmed Premiere',
    tags: ['Cyberpunk', 'Sci-Fi', 'Psychological'],
    description: 'Acclaimed studio Science SARU officially takes the helm for a brand-new television anime adaptation of Masamune Shirow’s legendary cyberpunk universe, premiering this July.',
    image: '/anime/ghost-in-the-shell.jpg',
    sourceLabel: 'Studio Announcement',
  },
  {
    id: 'kagurabachi',
    title: 'Kagurabachi: TV Anime Adaptation',
    timeline: 'Spring 2027 (Screenings 2026)',
    type: 'Worldwide Broadcast',
    studio: 'Major Studio TBA',
    badge: 'Highly Anticipated',
    tags: ['Action', 'Sorcery', 'Shonen Jump'],
    description: 'Weekly Shonen Jump’s breakout modern sensation prepares for global broadcast in Spring 2027, preceded by exclusive international festival preview screenings late in 2026.',
    image: '/anime/kagurabachi.jpg',
    sourceLabel: 'Shueisha Official',
  },
  {
    id: 'steel-ball-run',
    title: "JoJo's Bizarre Adventure: Steel Ball Run",
    timeline: 'Late 2026',
    type: 'Anime Series Production',
    studio: 'david production',
    badge: 'Major Milestone',
    tags: ['Supernatural', 'Historical', 'Horse Race'],
    description: 'Widely regarded by fans as Hirohiko Araki’s magnum opus, the cross-continental trans-American horse race saga prepares for its landmark anime unveiling.',
    image: '/anime/jojo-steel-ball-run.jpg',
    sourceLabel: 'Production Leak / Teaser',
  },
  {
    id: 'black-torch',
    title: 'Black Torch',
    timeline: 'July 4, 2026',
    type: 'Global Streaming',
    studio: 'Production I.G',
    badge: 'Summer Premiere',
    tags: ['Supernatural', 'Ninja', 'Shinobi Action'],
    description: 'Tsuyoshi Takaki’s stylish ninja x mononoke dark fantasy manga receives a high-octane anime adaptation debuting worldwide on Crunchyroll for Independence Day weekend.',
    image: '/anime/black-torch.jpg',
    sourceLabel: 'Crunchyroll Streaming',
  },
  {
    id: 'apothecary-diaries-s3',
    title: 'The Apothecary Diaries Season 3 & Movie',
    timeline: 'October 2026',
    type: '2-Cour Season + Film',
    studio: 'TOHO animation / OLM',
    badge: 'Franchise Expansion',
    tags: ['Historical', 'Mystery', 'Court Drama'],
    description: 'Maomao returns as the first cour debuts in October 2026, accompanied by plans for a theatrical feature film and further special OVAs exploring imperial court intrigue.',
    image: '/anime/apothecary-diaries.jpg',
    sourceLabel: 'Official Production Committee',
  },
  {
    id: 'dorohedoro-s2',
    title: 'Dorohedoro Season 2',
    timeline: 'Winter 2026 / 2027',
    type: 'Sequel Premiere',
    studio: 'MAPPA',
    badge: 'Long-Awaited Sequel',
    tags: ['Dark Fantasy', 'Comedy', 'Gore'],
    description: 'After years of silence, the grimy, magic-infused Hole returns to animation screens with a new ending theme music video and expanded second-season run.',
    image: '/anime/dorohedoro.jpg',
    sourceLabel: 'Studio MAPPA',
  },
];

const industryBriefs = [
  {
    title: "Anime Expo 2026 Lineup Finalized",
    date: "Confirmed Event",
    category: "Conventions",
    summary: "Crunchyroll has locked in premier panels, world premiere screenings, and special guest appearances featuring top Japanese directors and voice actors.",
  },
  {
    title: "MAPPA 15th Anniversary Revelations",
    date: "Upcoming Showcase",
    category: "Studio Spotlight",
    summary: "Studio leadership prepares special showcases expected to provide updates on Jujutsu Kaisen, Chainsaw Man, and unannounced original productions.",
  },
  {
    title: "Creative Integrity & Technology in Production",
    date: "Industry Analysis",
    category: "Industry Debate",
    summary: "Japanese animation directors and union representatives reaffirm the essential value of human artisan animators and hand-drawn background art amid new digital tools.",
  },
];
---

<Layout 
  title="News & Release Schedules | Manga Anime Webtoon" 
  description="Verified release dates, studio announcements, and deep-dive industry reporting on anime and manga."
>
  <!-- Hero Section with Literary Editorial Tone -->
  <section class="relative w-full overflow-hidden bg-canvas pt-16 pb-12 md:pt-24 md:pb-16 px-lg border-b border-hairline">
    <!-- Subtle Ambient Glow -->
    <div class="absolute inset-0 z-0 opacity-30 pointer-events-none overflow-hidden flex justify-center">
      <div class="absolute -top-24 w-[720px] h-[360px] bg-gradient-to-r from-blue-200 via-sky-200 to-indigo-100 blur-[110px] rounded-full"></div>
    </div>

    <div class="relative z-10 max-w-[1280px] mx-auto flex flex-col gap-md">
      <!-- Section Tag / Eyebrow -->
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-hairline bg-canvas-soft text-caption font-mono uppercase tracking-widest text-ink">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
          Industry Dispatch
        </span>
        <span class="text-caption font-mono text-mute tracking-wider hidden sm:inline">Verified Release Schedules</span>
      </div>

      <!-- Main Headline -->
      <div class="flex flex-col gap-3">
        <h1 class="text-display-lg md:text-display-xl font-semibold tracking-[-1.5px] md:tracking-[-2px] text-ink max-w-[20ch]">
          The Daily Dispatch
        </h1>
        <p class="text-display-sm font-normal text-body text-slate-600 tracking-tight max-w-[32ch]">
          Confirmed release dates, production reveals, and studio headlines.
        </p>
      </div>

      <!-- Editorial Intro Copy -->
      <div class="mt-2 max-w-[820px] flex flex-col gap-3 text-body-md md:text-body-lg text-body text-slate-700 leading-relaxed">
        <p>
          Stay ahead of upcoming seasons with curated production updates. We cut through rumors to deliver verified broadcast dates, trailer drops, and behind-the-scenes insights directly from studios and production committees.
        </p>
        <p class="text-slate-600 text-body-md">
          From historic sequels to anticipated adaptations, track every major premiere on the horizon.
        </p>
      </div>

      <!-- Editorial Motto Pill -->
      <div class="mt-4 pt-4 border-t border-hairline flex flex-wrap items-center gap-3">
        <span class="font-mono text-caption uppercase tracking-widest text-mute">Reporting Standards</span>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-canvas-soft border border-hairline text-body-sm font-medium text-ink">
          <span>Verified Sources.</span>
          <span class="text-mute">·</span>
          <span>Zero Clickbait.</span>
          <span class="text-mute">·</span>
          <span class="text-blue-600">Context & Analysis.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main 3-Column Release Announcement Grid -->
  <section class="w-full bg-canvas py-12 md:py-16 px-lg">
    <div class="max-w-[1280px] mx-auto flex flex-col gap-10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-hairline pb-4">
        <div>
          <h2 class="text-display-sm md:text-display-md font-semibold text-ink tracking-tight">
            Upcoming Premieres & Key Announcements
          </h2>
          <p class="text-body-sm text-mute mt-1">
            Confirmed broadcast windows and adaptation announcements across major animation studios.
          </p>
        </div>
        <div class="text-caption font-mono text-mute">
          {releaseSchedule.length} Verified Premieres
        </div>
      </div>

      <!-- 3-Column Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {releaseSchedule.map((item, index) => (
          <article 
            class="group flex flex-col bg-white rounded-2xl border border-hairline hover:border-slate-300 transition-all duration-300 shadow-[0_4px_20px_-10px_rgba(0,0,0,0.05)] hover:shadow-[0_20px_40px_-15px_rgba(15,23,42,0.12)] overflow-hidden"
          >
            <!-- Card Image Showcase -->
            <div class="relative w-full overflow-hidden border-b border-hairline bg-slate-100">
              <img 
                src={item.image} 
                alt={`${item.title} key art`}
                class="anime-card-image transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                loading={index < 3 ? 'eager' : 'lazy'}
              />
              
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-70 group-hover:opacity-50 transition-opacity"></div>

              <!-- Top Badges -->
              <div class="absolute top-3 left-3 right-3 flex items-center justify-between gap-2 pointer-events-none">
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-mono font-medium tracking-wide uppercase bg-black/75 text-white backdrop-blur-md border border-white/20 shadow-sm">
                  {item.type}
                </span>

                {item.badge && (
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold tracking-wide uppercase bg-blue-600 text-white shadow-md">
                    <span>{item.badge}</span>
                  </span>
                )}
              </div>

              <!-- Bottom Plaque -->
              <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between pointer-events-none">
                <span class="text-[12px] font-mono text-white/90 drop-shadow-md">
                  {item.timeline}
                </span>
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-black/70 text-slate-200 border border-white/10">
                  {item.studio}
                </span>
              </div>
            </div>

            <!-- News Details & Editorial Breakdown -->
            <div class="p-6 flex flex-col flex-1 justify-between gap-4">
              <div class="flex flex-col gap-2.5">
                <!-- Genre / Topic List -->
                <div class="flex items-center flex-wrap gap-1.5 text-caption font-medium text-blue-600">
                  {item.tags.map((tag, tIdx) => (
                    <span class="inline-flex items-center">
                      <span>{tag}</span>
                      {tIdx < item.tags.length - 1 && (
                        <span class="text-slate-300 mx-1.5 font-normal">·</span>
                      )}
                    </span>
                  ))}
                </div>

                <!-- Title -->
                <div>
                  <h3 class="text-display-sm font-semibold text-ink group-hover:text-blue-600 transition-colors leading-snug">
                    {item.title}
                  </h3>
                  <p class="text-caption font-mono text-mute mt-0.5">
                    Source: {item.sourceLabel}
                  </p>
                </div>

                <!-- Description -->
                <p class="text-body-sm text-body text-slate-600 leading-relaxed mt-1">
                  {item.description}
                </p>
              </div>

              <!-- Hallmarks / Meta Footer -->
              <div class="pt-4 border-t border-hairline mt-auto flex items-center justify-between text-[11px] font-mono text-mute">
                <span class="uppercase tracking-wider">Release Target</span>
                <span class="text-slate-800 font-medium">{item.timeline}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Deep Dive Magazine Feature: State of the Industry -->
  <section class="w-full bg-canvas-soft py-16 px-lg border-t border-hairline">
    <div class="max-w-[1280px] mx-auto flex flex-col gap-10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-hairline pb-4">
        <div>
          <span class="font-mono text-caption uppercase tracking-wider text-blue-600 font-medium">In-Depth Editorial Analysis</span>
          <h2 class="text-display-md font-semibold text-ink tracking-tight mt-1">
            The Industry Outlook: Seasons Ahead
          </h2>
          <p class="text-body-sm text-body text-mute max-w-[680px] mt-1">
            A comprehensive overview of studio shifts, major conventions, and emerging creative debates.
          </p>
        </div>
        <span class="text-caption font-mono text-mute hidden sm:inline">Special Feature</span>
      </div>

      <!-- Feature Article Card -->
      <div class="bg-white rounded-2xl border border-hairline p-8 md:p-10 shadow-[0_4px_24px_-12px_rgba(0,0,0,0.06)] flex flex-col gap-6">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-caption font-mono font-medium border border-blue-100">
            Market & Production Report
          </span>
          <span class="text-caption font-mono text-mute">Updated for 2026 Season</span>
        </div>

        <h3 class="text-display-sm md:text-display-md font-semibold text-ink tracking-tight">
          How Animation Studios Are Redefining Expectations for 2026 and Beyond
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-body-md text-slate-700 leading-relaxed border-t border-hairline pt-6">
          <div class="flex flex-col gap-4">
            <p>
              The global anime industry continues to expand at a historic pace. With the return of beloved dark fantasy properties like <strong>Dorohedoro Season 2</strong>, production studios are doubling down on distinctive aesthetic voices rather than homogenized visual formulas.
            </p>
            <p>
              Convention organizers at <strong>Anime Expo 2026</strong> have announced expanded showcase halls dedicated to international co-productions and direct creator-fan panels. With high-profile studio anniversaries from the likes of <strong>MAPPA</strong>, the competitive landscape for cinematic animation quality has never been higher.
            </p>
          </div>

          <div class="flex flex-col gap-4">
            <p>
              Simultaneously, creative leadership across Tokyo studios has ignited vital discussions around emerging digital and automated tools. Veteran directors and studio heads have reaffirmed a clear stance: technology must serve human animators, not displace the craftsmanship that defines Japanese animation history.
            </p>
            <p>
              As streaming platforms consolidate release calendars, fans can look forward to increasingly ambitious multi-part adaptations and simultaneous global simulcasts.
            </p>
          </div>
        </div>

        <!-- Source Citation & Link -->
        <div class="mt-2 pt-4 border-t border-hairline flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-body-sm">
          <div class="flex items-center gap-2 text-mute text-caption font-mono">
            <span>Primary Sources: Studio Releases · Crunchyroll News · Industry Committees</span>
          </div>
          <a 
            href="https://www.crunchyroll.com/news/latest" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-link hover:underline font-medium text-body-sm"
          >
            Read External Source Wire →
          </a>
        </div>
      </div>

      <!-- Quick Briefs 3-Column Row -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {industryBriefs.map((brief) => (
          <div class="bg-white p-5 rounded-xl border border-hairline hover:border-slate-300 transition-colors flex flex-col justify-between gap-3 shadow-xs">
            <div class="flex flex-col gap-2">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-100 font-medium">
                  {brief.category}
                </span>
                <span class="text-[11px] font-mono text-mute">
                  {brief.date}
                </span>
              </div>
              <h4 class="text-[16px] font-semibold text-ink leading-snug">
                {brief.title}
              </h4>
              <p class="text-body-sm text-slate-600 leading-relaxed mt-1">
                {brief.summary}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- Tip Line Box -->
      <div class="p-6 rounded-2xl border border-dashed border-slate-300 bg-white/70 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h4 class="text-body-md font-semibold text-ink">Have breaking industry news or studio confirmation?</h4>
          <p class="text-body-sm text-mute mt-0.5">
            Submit verified press releases, event schedules, or licensing announcements to our desk.
          </p>
        </div>
        <a 
          href="mailto:admin@mangaanimewebtoon.com?subject=News%20Tip%20or%20Press%20Release" 
          class="shrink-0 px-4 py-2 rounded-full bg-ink text-white hover:bg-slate-800 text-body-sm font-medium transition-colors"
        >
          Send News Tip
        </a>
      </div>
    </div>
  </section>
</Layout>
