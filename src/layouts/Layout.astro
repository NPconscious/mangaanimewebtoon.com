---
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Manga Anime Webtoon - Your ultimate source for the latest news." } = Astro.props;
const isHomePage = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en" data-type={isHomePage ? "service" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    {isHomePage && <meta name="page-type" content="service" />}
    {isHomePage && <meta name="site-kind" content="other" />}
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap" rel="stylesheet">
    
    <title>{title}</title>
  </head>
  <body class:list={["flex flex-col min-h-screen", { "home-page": Astro.url.pathname === "/" }]}>
    <Navbar />
    <main class="flex-1 w-full flex flex-col items-center">
      <slot />
    </main>
    {isHomePage && (
      <div class="sakura-fall" aria-hidden="true"></div>
    )}
    <Footer />
  </body>
</html>
